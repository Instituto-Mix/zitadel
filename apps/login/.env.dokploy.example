# Runtime env for the forked Login v2 container (Dokploy).
# Copy to your Dokploy service env. Values marked (build-time) are NOT here —
# they are baked via Docker build ARGs (see Dockerfile.dokploy).
#
# Build-time (set as build args, not here):
#   SERVER_ACTION_ALLOWED_ORIGINS=entrar.institutomix.com.br   # the domain (default)
#   NEXT_PUBLIC_BASE_PATH=                                       # empty => served at root

# --- Zitadel connection (required) ---
# Base URL of the Zitadel API/issuer this login app talks to.
ZITADEL_API_URL=https://your-zitadel-instance.example.com
# Service user PAT with the login client permissions. Prefer a file mount +
# ZITADEL_SERVICE_USER_TOKEN_FILE in production; the raw token also works:
ZITADEL_SERVICE_USER_TOKEN=

# --- Track B: legacy backend (this fork's feature) ---
# Backend used for two things. Include the API version prefix; the app POSTs to
# {AUTH_BACKEND_URL}/auth/resolve and {AUTH_BACKEND_URL}/auth/legacy-migrate.
#   1. /auth/resolve        translates a typed tax number / legacy username into
#                           the canonical Zitadel loginName.
#   2. /auth/legacy-migrate first access: verifies the typed password against the
#                           legacy ERP digest. The ERP password is proof of
#                           identity only and is never installed (most legacy
#                           passwords fail Zitadel's complexity policy). On a
#                           match the backend returns a reset code, and the app
#                           makes the user choose a new, compliant password —
#                           which is also the mandatory rotation.
# If either var is unset BOTH features are skipped: login still works normally
# with real loginNames and existing Zitadel passwords (fail-open), but
# provisioned users cannot complete a first access.
AUTH_BACKEND_URL=https://your-auth-backend.example.com/v1
# Must equal the backend's RESOLVE_ALLOWED_SERVICE_ACCOUNT (a 64-char shared
# secret) — NOT the `login-page` Zitadel machine user's PAT. The backend's guard
# is a plain string compare, not a Zitadel identity check, and it runs on BOTH
# endpoints above; a mismatch rejects every call with a uniform 403 before any
# credential is looked at (which surfaces to the user as "user not found" for a
# legacy identifier, "wrong password" for a first access).
# Sent as the `x-zitadel-service-account` header (NOT Authorization: Bearer).
# Bearer secret: server-side only, never logged, never NEXT_PUBLIC_.
AUTH_BACKEND_TOKEN=

# --- Optional ---
EMAIL_VERIFICATION=false
# Disable the OpenTelemetry Node SDK unless you run a collector.
OTEL_SDK_DISABLED=true
# CSP iframe origins are fetched from Zitadel; set false to skip that fetch.
# CSP_FETCH_ENABLED=false
